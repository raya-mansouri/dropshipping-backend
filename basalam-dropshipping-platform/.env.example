# ── Database (required) ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/basalam

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── JWT / Auth (SECRET_KEY required) ───────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Basalam API ────────────────────────────────────────────────────────────────
BASALAM_CLIENT_ID=your_client_id_here
BASALAM_CLIENT_SECRET=your_client_secret_here
BASE_URL=http://localhost:8000

# ── MinIO / Storage ────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=basalam-images
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# ── Image Processing ───────────────────────────────────────────────────────────
CDN_BASE_URL=https://cdn.basalam.com
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1920
IMAGE_QUALITY=85
IMAGE_FORMAT=WEBP
IMAGE_HTTP_TIMEOUT=30.0

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SENTRY_DSN=
CORS_ORIGINS=*
